{% sw_extends '@Storefront/storefront/component/payment/payment-method.html.twig' %}

{% block component_payment_method_description %}
    {{ parent() }}

    {% set appPaymentMethodId = payment.appPaymentMethod.identifier %}

    {% if payment.id is same as(selectedPaymentMethodId ?? context.paymentMethod.id) and appPaymentMethodId == 'credit_card' %}
        {% sw_include '@SwagBraintreeApp/storefront/braintree/component/checkout/braintree-hosted-fields.html.twig' %}
    {% endif %}
{% endblock %}
