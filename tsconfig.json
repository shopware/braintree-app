{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "baseUrl": ".",
    "module": "ES2020",
    "skipLibCheck": true,

    /* Node mode */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "types": ["vite/client"],

    "paths": {
      "@/*": ["assets/src/*"]
    }
  },
  "include": [
    "./assets/**/*.ts",
    "./assets/**/*.vue"
  ],
}
